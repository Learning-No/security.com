# Copy this file to .env and replace the placeholder with a long random secret.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-this-with-a-random-secret-at-least-32-characters
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://ironhaven:change-this-password@db:5432/ironhaven
ACCESS_TOKEN_MINUTES=30
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5500
